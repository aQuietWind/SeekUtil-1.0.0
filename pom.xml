<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.15</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.seek.util</groupId>
    <artifactId>SeekUtil</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>SeekUtil</name>
    <description>SeekUtil,The Tool of every project</description>
    <packaging>pom</packaging>

    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>21</java.version>
        <!--        依赖版本-->
        <mybatis.version>3.0.5</mybatis.version>
        <springCloud.version>2025.0.2</springCloud.version>
        <springCloudAlibaba.version>2023.0.1.0</springCloudAlibaba.version>
        <jvmCaffeine.version>3.1.8</jvmCaffeine.version>
        <swagger.version>2.8.15</swagger.version>
        <self.version>1.0-SNAPSHOT</self.version>
        <skywalking.version>9.3.0</skywalking.version>
        <jwt.version>0.13.0</jwt.version>
        <jakarta.version>6.1.0</jakarta.version>
        <redisson.version>3.13.6</redisson.version>
        <spatial4j.version>0.8</spatial4j.version>
        <rocketmq.version>2.3.0</rocketmq.version>
        <langchain4j.version>1.17.2-beta27</langchain4j.version>
        <springai.version>1.1.8</springai.version>
    </properties>
    <!--    依赖版本管理-->
    <dependencyManagement>
        <dependencies>
            <!-- mybatis依赖            -->
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>${mybatis.version}</version>
            </dependency>
            <!-- 适配 Spring Boot 3.5.x/4.x、JDK 21 的最新稳定版 -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${springCloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- springcloudAlibaba           -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${springCloudAlibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- jvm缓存 -->
            <dependency>
                <groupId>com.github.ben-manes.caffeine</groupId>
                <artifactId>caffeine</artifactId>
                <version>${jvmCaffeine.version}</version>
            </dependency>
            <!-- swagger接口文档自动生成 -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${swagger.version}</version>
            </dependency>
            <!-- skywalking日志依赖           -->
            <dependency>
                <groupId>org.apache.skywalking</groupId>
                <artifactId>apm-toolkit-logback-1.x</artifactId>
                <version>${skywalking.version}</version>
            </dependency>
            <!--jwt依赖1-->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jwt.version}</version>
            </dependency>
            <!--jwt依赖2-->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jwt.version}</version>
            </dependency>
            <!--jwt依赖3-->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jwt.version}</version>
            </dependency>
            <!--        redisson依赖-->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <!--        cookie解析包-->
            <dependency>
                <groupId>jakarta.servlet</groupId>
                <artifactId>jakarta.servlet-api</artifactId>
                <version>${jakarta.version}</version>
                <scope>provided</scope>
            </dependency>
            <!--        地理位置运算依赖-->
            <dependency>
                <groupId>org.locationtech.spatial4j</groupId>
                <artifactId>spatial4j</artifactId>
                <version>${spatial4j.version}</version>
            </dependency>
            <!-- RocketMQ的依赖 -->
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-spring-boot-starter</artifactId>
                <version>${rocketmq.version}</version>
            </dependency>
            <!-- langchain4j的ollama版本的spring集成 -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-ollama-spring-boot-starter</artifactId>
                <version>${langchain4j.version}</version>
            </dependency>
            <!-- langchain4j普通版本依赖 -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-spring-boot-starter</artifactId>
                <version>${langchain4j.version}</version>
            </dependency>
            <!-- Ollama starter，对接本地ollama -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-starter-model-ollama</artifactId>
                <version>${springai.version}</version>
            </dependency>
            <!--该项目的ConfigObject模块        -->
            <dependency>
                <groupId>${groupId}</groupId>
                <artifactId>ConfigObject</artifactId>
                <version>${self.version}</version>
            </dependency>
            <!--该项目的ConfigObject模块        -->
            <dependency>
                <groupId>${groupId}</groupId>
                <artifactId>RedisUtil</artifactId>
                <version>${self.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 对于仓库上传的设置 -->
    <distributionManagement>
        <repository>
            <!-- 该id与maven配置中的要相对应,这样才能找到目标nexus -->
            <id>self-nexux-server</id>
            <!-- 设置目标仓库的地址 -->
            <url>http://localhost:8081/repository/maven-releases</url>
        </repository>
        <snapshotRepository>
            <id>self-nexux-server</id>
            <url>http://localhost:8081/repository/maven-snapshots</url>
        </snapshotRepository>
    </distributionManagement>

    <!--子模块管理-->
    <modules>
        <module>ConfigObject</module>
        <module>RedisUtil</module>
        <module>ElasticsearchUtil</module>
        <module>MybatisPlusUtil</module>
        <module>Langchain4jUtil</module>
        <module>SpringAiUtil</module>
        <module>MongoDBUtil</module>
        <module>SentinelUtil</module>
        <module>FeignUtil</module>
        <module>GatewayUtil</module>
        <module>RabbitMQUtil</module>
        <module>RocketMQUtil</module>
        <module>KafkaUtil</module>
        <module>NacosUtil</module>
        <module>SkyWalkingUtil</module>
        <module>CommonUtil</module>
        <module>JWTUtil</module>
        <module>WebUtil</module>
        <module>CaffeineUtil</module>
    </modules>


</project>
